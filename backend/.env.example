# Copy this file to .env and adjust as needed.

DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Railway MySQL connection string.
# Copy the value from Railway and never commit the real credential.
DATABASE_URL=mysql://USERNAME:PASSWORD@HOST:PORT/DATABASE

# Frontend origins allowed to call the API (comma separated)
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5501,http://localhost:5501

# Where frontend/ is actually served from — used to build the link
# emailed out by the forgot-password flow.
FRONTEND_URL=http://127.0.0.1:5501
CORS_ALLOW_ALL_ORIGINS=false
